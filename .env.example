# Copy this to .env and fill in your own values. Never commit the real .env.

AWS_PROFILE=default
AWS_REGION=us-west-2

# Verified reliable in testing. Swap for your own if you have working Anthropic access:
#   us.anthropic.claude-sonnet-4-6   (regional profile — NOT global.anthropic.claude-sonnet-4-6)
MODEL_ID=us.amazon.nova-pro-v1:0

# Only needed for track2-agentcore and track3-talk-gaps/g2-g4, after you've run
# `agentcore deploy` yourself (see track2-agentcore/module4-runtime/README.md):
AGENT_RUNTIME_ARN=
MEMORY_ID=
